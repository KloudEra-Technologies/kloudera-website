  "deployment_instructions": {
    "nginx": {
      "location": "/etc/nginx/conf.d/security-headers.conf",
      "headers": [
        "add_header Strict-Transport-Security \"max-age=31536000; includeSubDomains; preload\" always;",
        "add_header X-Content-Type-Options \"nosniff\" always;",
        "add_header X-Frame-Options \"DENY\" always;",
        "add_header X-XSS-Protection \"1; mode=block\" always;",
        "add_header Referrer-Policy \"strict-origin-when-cross-origin\" always;",
        "add_header Content-Security-Policy \"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'\" always;"
      ]
    },
    "cloudflare": {
      "method": "Transform Rules > Modify Response Headers",
      "note": "Recommended for faster deployment without web server restart"
    },
    "dns": {
      "spf_record": "v=spf1 include:sendgrid.net include:mailgun.org ~all",
      "dkim_record": "Contact email provider for DKIM public key",
      "dmarc_record": "v=DMARC1; p=quarantine; rua=mailto:security@kloudera.ai"
    }
